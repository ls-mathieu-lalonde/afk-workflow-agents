# Cheap models for routing tests. Only routing is under test, so every agent
# uses the same inexpensive model. Passed to install.sh by run-scenario.sh.
# haiku is picked for a combination of price and speed
MODEL_AFK_ORCHESTRATOR=github-copilot/claude-haiku-5.5
MODEL_CODER=github-copilot/claude-haiku-5.5
MODEL_REVIEWER=github-copilot/claude-haiku-5.5
MODEL_DEEP_REVIEWER=github-copilot/claude-haiku-5.5
