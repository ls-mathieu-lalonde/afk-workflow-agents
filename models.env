# Default model for each agent. install.sh substitutes these values into the
# {{MODEL_*}} placeholders in agents/*.md. The variable for an agent is
# MODEL_ + its file name in upper case, with '-' replaced by '_'.
MODEL_AFK_ORCHESTRATOR=github-copilot/gpt-6-luna
MODEL_CODER=github-copilot/gpt-6-luna
MODEL_REVIEWER=github-copilot/gpt-6.1-sol
MODEL_DEEP_REVIEWER=github-copilot/claude-opus-5.5
